[0.015, "o", "\u001b[1mID                        \u001b[0m  \u001b[1mTITLE                                                                \u001b[0m  \u001b[1mSTATUS\u001b[0m\r\r\n\u001b[2mcut-1.2.0-release         \u001b[0m  \u001b[2mPublish the missing v1.2.0 GitHub release                            \u001b[0m  \u001b[2mclosed\u001b[0m\r\r\n\u001b[2mwindows-binaries          \u001b[0m  \u001b[2mAdd Windows to the release binary matrix                             \u001b[0m  \u001b[2mclosed\u001b[0m\r\r\n\u001b[2mcut-1.3.0-release         \u001b[0m  \u001b[2mPublish v1.3.0 to crates.io and GitHub                               \u001b[0m  \u001b[2mclosed\u001b[0m\r\r\n\u001b[2mwindows-build-failure     \u001b[0m  \u001b[2mFix the Windows release build (cfg(not(unix)) never compiled)        \u001b[0m  \u001b[2mclosed\u001b[0m\r\r\n\u001b[2mnever-move-a-published-tag\u001b[0m  \u001b[2mRelease process: check a version tag doesn't exist before creating it\u001b[0m  \u001b[2mclosed\u001b[0m\r\r\n\u001b[2marticle-demos             \u001b[0m  \u001b[2mFour demos for the launch article, each tied to a paragraph          \u001b[0m  \u001b[2mclosed\u001b[0m\r\r\n"]
