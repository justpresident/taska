# The README demo, driven by scriptty - a PTY demo engine that simulates typing
# independently of how the program echoes it: https://github.com/justpresident/scriptty
#
# Record it with the wrapper, which builds a throwaway repo, runs this script and
# renders the GIF:
#
#   bash docs/record-demo.sh              # -> docs/demo.gif
#   bash docs/record-demo.sh --preview    # watch it, record nothing
#
# It needs scriptty with the PTY-sizing fix (--cols/--rows) and the `\e` string
# escape, plus asciinema and agg, and tells you which is missing:
#
#   cargo install --git https://github.com/justpresident/scriptty
#
# COLOUR. Three layers, so the eye can separate them:
#   - the prompt is a bold green `$` (set in docs/demo-setup.sh), marking where
#     each step begins;
#   - narration is grey, and goes through `show` rather than `type` because
#     `show` writes straight to the terminal and can therefore carry SGR codes -
#     anything typed is echoed by bash in the default colour and cannot be
#     styled. The cost is one blank line per narration line: `show` bypasses the
#     program, so an Enter is needed to make bash draw the next prompt.
#   - command output keeps taska's own colours (cyan ids, green status, dim for
#     done), which is what should stand out.
# Keep the prompt's trailing space INSIDE its colour span: with the reset in
# between, the literal "$ " is no longer contiguous and `expect "$ "` stops
# matching.
#
# The recording is pinned to 80x24. Pinning the PTY narrower than the real
# terminal only wraps sooner than necessary; pinning it WIDER is what produces
# the overwriting redraw - so record in a terminal at least 80 columns wide.
#
# The longest typed line here is 70 characters plus the 2-character prompt, so it
# fits 80 columns with room to spare - keep it that way when editing.
#
# Every step waits on the shell prompt rather than a fixed sleep, so the demo
# can't race a slow machine and needs no retiming when output changes.
expect "$ "

show "\e[90m# two tasks, and a dependency between them\e[0m"
key Enter
expect "$ "
wait 400ms
type "ta create migrate-db title='Run DB migration' status=open owner=alice"
key Enter
expect "$ "

type "ta create deploy-api title='Deploy the API' status=open owner=bob"
key Enter
expect "$ "

type "ta dep add deploy-api depends_on=migrate-db"
key Enter
expect "$ "

wait 600ms
show "\e[90m# --ready computes what is actually actionable: deploy-api is blocked\e[0m"
key Enter
expect "$ "
wait 400ms
type "ta list --ready"
key Enter
expect "$ "
wait 1500ms

type "git add -A && git commit -qm 'track the backlog'"
key Enter
expect "$ "

wait 600ms
show "\e[90m# an agent picks up the migration on its own branch\e[0m"
key Enter
expect "$ "
wait 400ms
type "git checkout -q -b agent/migrate && ta update migrate-db status=closed"
key Enter
expect "$ "
type "git commit -qam 'agent: migration done'"
key Enter
expect "$ "

wait 600ms
show "\e[90m# meanwhile, on main, you reassign that same task\e[0m"
key Enter
expect "$ "
wait 400ms
type "git checkout -q main && ta update migrate-db owner=carol"
key Enter
expect "$ "
type "git commit -qam 'main: reassign'"
key Enter
expect "$ "

wait 800ms
show "\e[90m# no database, no daemon, no human: git merges the task log\e[0m"
key Enter
expect "$ "
wait 400ms
type "git merge agent/migrate -m 'merge agent branch'"
key Enter
expect "$ "
wait 1500ms

show "\e[90m# both edits survived - status from the agent, owner from you\e[0m"
key Enter
expect "$ "
wait 400ms
type "ta show migrate-db"
key Enter
expect "$ "
wait 2500ms

show "\e[90m# and closing the migration unblocked the deploy\e[0m"
key Enter
expect "$ "
wait 400ms
type "ta list --ready"
key Enter
expect "$ "
wait 3s
